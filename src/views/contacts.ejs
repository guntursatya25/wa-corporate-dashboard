<%- include('partials/head', { active: 'contacts' }) %>

<h1>Contacts</h1>

<div class="card">
  <h2 style="margin-top:0;"><%= editContact ? 'Edit contact' : 'Add contact' %></h2>
  <form method="post" action="/contacts">
    <% if (editContact) { %>
      <input type="hidden" name="id" value="<%= editContact.id %>">
    <% } %>
    <div class="row">
      <div>
        <label for="name">Name</label>
        <input id="name" name="name" value="<%= editContact?.name || '' %>" placeholder="Alex Smith" required>
      </div>
      <div>
        <label for="phone">Phone (international format)</label>
        <input id="phone" name="phone" value="<%= editContact?.phone || '' %>" placeholder="6281234567890" required>
      </div>
    </div>
    <label for="note">Note (optional)</label>
    <input id="note" name="note" value="<%= editContact?.note || '' %>" placeholder="e.g. VIP customer">
    <label for="contact-groups">Groups</label>
    <select id="contact-groups" name="groups" multiple size="<%= Math.min(Math.max(groups.length, 2), 5) %>">
      <% for (const group of groups) { %>
        <option value="<%= group.id %>" <%= editGroupIds.includes(group.id) ? 'selected' : '' %>><%= group.name %> (<%= group.member_count %>)</option>
      <% } %>
    </select>
    <p class="muted">Hold Ctrl or Command to select multiple groups. Saving a phone number updates its contact and memberships.</p>
    <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-save"></use></svg><%= editContact ? 'Update contact' : 'Save contact' %></button>
    <% if (editContact) { %>
      <a class="button-link secondary" href="/contacts"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-x"></use></svg>Cancel edit</a>
    <% } %>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0;">Contact groups</h2>
  <form method="post" action="/groups" class="row">
    <div>
      <label for="group-name">New group name</label>
      <input id="group-name" name="name" placeholder="e.g. Customers" required>
    </div>
    <div style="display:flex;align-items:flex-end;">
      <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-plus"></use></svg>Create group</button>
    </div>
  </form>
  <% if (!groups.length) { %>
    <div class="empty">No groups yet. Create one to send a message to several contacts.</div>
  <% } else { %>
    <table>
      <tr><th>Group</th><th>Members</th><th></th></tr>
      <% for (const group of groups) { %>
        <tr>
          <td><strong><%= group.name %></strong></td>
          <td><span class="badge"><%= group.member_count %> contacts</span></td>
          <td>
            <form method="post" action="/groups/delete" style="margin:0;" onsubmit="return confirm('Delete group <%= group.name %> ? Contacts will remain.')">
              <input type="hidden" name="id" value="<%= group.id %>">
              <button class="mini danger" type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-trash"></use></svg>Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">Import contacts</h2>
  <form method="post" action="/contacts/import" id="contact-import-form">
    <label for="csv-file">CSV file</label>
    <input id="csv-file" type="file" accept=".csv,text/csv" required>
    <label for="import-group">Add imported contacts to group (optional)</label>
    <select id="import-group" name="group_id">
      <option value="">No group</option>
      <% for (const group of groups) { %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% } %>
    </select>
    <textarea id="csv" name="csv" hidden></textarea>
    <p class="muted">CSV must have a header row with <code>name</code> and <code>phone</code> columns. Existing phone numbers are updated.</p>
    <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-upload"></use></svg>Import CSV</button>
  </form>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <h2 style="margin:0;">Contact book</h2>
    <a class="button-link secondary" href="/export/contacts.csv"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-download"></use></svg>Export CSV</a>
  </div>
  <% if (!contacts.length) { %>
    <div class="empty">No contacts yet</div>
  <% } else { %>
    <table>
      <tr><th>Name</th><th>Phone</th><th>Groups</th><th>Note</th><th></th><th style="width:80px;"></th></tr>
      <% for (const c of contacts) { %>
        <tr>
          <td><strong><%= c.name %></strong></td>
          <td><%= c.phone %></td>
          <td><%= c.group_names || '—' %></td>
          <td class="muted"><%= c.note || '—' %></td>
          <td><a class="button-link secondary mini" href="/contacts?edit=<%= c.id %>"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-file"></use></svg>Edit</a></td>
          <td>
            <form method="post" action="/contacts/delete" style="margin:0;" onsubmit="return confirm('Delete contact <%= c.name %> ?')">
              <input type="hidden" name="id" value="<%= c.id %>">
              <button class="mini danger" type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-trash"></use></svg>Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<script>
  document.getElementById('contact-import-form')?.addEventListener('submit', function (event) {
    const file = document.getElementById('csv-file').files[0];
    if (!file) return;
    event.preventDefault();
    const reader = new FileReader();
    reader.onload = function () {
      document.getElementById('csv').value = reader.result;
      event.target.submit();
    };
    reader.onerror = function () { alert('Could not read the CSV file.'); };
    reader.readAsText(file);
  });
</script>

<%- include('partials/foot') %>
