<%- include('partials/head', { active: 'contacts' }) %>

<h1>Contacts</h1>

<div class="card">
  <h2 style="margin-top:0;">Add / update contact</h2>
  <form method="post" action="/contacts">
    <div class="row">
      <div>
        <label for="name">Name</label>
        <input id="name" name="name" placeholder="Alex Smith" required>
      </div>
      <div>
        <label for="phone">Phone (international format, without +)</label>
        <input id="phone" name="phone" placeholder="6281234567890" required>
      </div>
    </div>
    <label for="note">Note (optional)</label>
    <input id="note" name="note" placeholder="e.g. VIP customer">
    <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-save"></use></svg>Save contact</button>
  </form>
  <p class="muted" style="margin-bottom:0;">The same phone number updates the name and note.</p>
</div>

<div class="card">
  <% if (!contacts.length) { %>
    <div class="empty">No contacts yet</div>
  <% } else { %>
    <table>
      <tr><th>Name</th><th>Phone</th><th>Note</th><th style="width:80px;"></th></tr>
      <% for (const c of contacts) { %>
        <tr>
          <td><strong><%= c.name %></strong></td>
          <td><%= c.phone %></td>
          <td class="muted"><%= c.note || '—' %></td>
          <td>
            <form method="post" action="/contacts/delete" style="margin:0;" onsubmit="return confirm('Delete contact <%= c.name %> ?')">
              <input type="hidden" name="id" value="<%= c.id %>">
              <button class="mini danger" type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-trash"></use></svg>Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>
