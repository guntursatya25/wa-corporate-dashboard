<%- include('partials/head', { active: 'inbox' }) %>

<h1>Inbox</h1>

<div class="card">
  <form method="get" action="/inbox">
    <div class="row">
      <div><label for="q">Search messages / contacts / chats</label><input id="q" name="q" value="<%= filters?.query || '' %>" placeholder="Keyword"></div>
      <div><label for="from">From date</label><input id="from" type="date" name="from" value="<%= filters?.from || '' %>"></div>
      <div><label for="to">To date</label><input id="to" type="date" name="to" value="<%= filters?.to || '' %>"></div>
    </div>
    <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-search"></use></svg>Search</button>
    <a class="button-link secondary" href="/inbox"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-x"></use></svg>Clear</a>
    <a class="button-link secondary" href="/export/messages.csv"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-download"></use></svg>Export messages CSV</a>
    <a class="button-link secondary" href="/export/contacts.csv"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-download"></use></svg>Export contacts CSV</a>
  </form>
</div>

<% if (chat) { %>
  <div class="card">
    <h2 style="margin-top:0;">Chat: <%= chat_id %></h2>
    <a href="/inbox" class="button-link muted-link"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-inbox"></use></svg>Back to all messages</a>
    <div style="margin-top:12px;">
      <% for (const m of chat) { %>
        <div style="margin-bottom:10px; <%= m.direction === 'out' ? 'text-align:right;' : '' %>">
          <div style="display:inline-block; max-width:70%; background: <%= m.direction === 'out' ? '#dbeafe' : '#fff' %>; border:1px solid var(--border); border-radius:10px; padding:8px 12px; text-align:left;">
            <pre class="body"><%= m.body %></pre>
            <div class="muted"><%= m.direction === 'out' ? '→ Sent' : '← Received' %> · <%= m.created_at %></div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="card">
    <h2 style="margin-top:0;">Received messages (<%= inbox.length %>)</h2>
    <% if (!inbox.length) { %>
      <div class="empty">No received messages yet</div>
    <% } else { %>
      <table>
        <tr><th>Time</th><th>Session</th><th>Chat</th><th>Contact</th><th>Message</th><th></th></tr>
        <% for (const m of inbox) { %>
          <tr>
            <td class="muted"><%= m.created_at %></td>
            <td><%= m.session %></td>
            <td><%= m.chat_id %></td>
            <td><%= m.contact_name || '—' %></td>
            <td><pre class="body"><%= m.body.length > 60 ? m.body.slice(0, 60) + '…' : m.body %></pre></td>
            <td><a href="/inbox?chat=<%= encodeURIComponent(m.chat_id) %>">View</a></td>
          </tr>
        <% } %>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">Sent messages (<%= outbox.length %>)</h2>
    <% if (!outbox.length) { %>
      <div class="empty">No sent messages yet</div>
    <% } else { %>
      <table>
        <tr><th>Time</th><th>Session</th><th>Chat</th><th>Message</th><th></th></tr>
        <% for (const m of outbox) { %>
          <tr>
            <td class="muted"><%= m.created_at %></td>
            <td><%= m.session %></td>
            <td><%= m.chat_id %></td>
            <td><pre class="body"><%= m.body.length > 60 ? m.body.slice(0, 60) + '…' : m.body %></pre></td>
            <td><a href="/inbox?chat=<%= encodeURIComponent(m.chat_id) %>">View</a></td>
          </tr>
        <% } %>
      </table>
    <% } %>
  </div>
<% } %>

<%- include('partials/foot') %>
