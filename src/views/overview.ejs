<%- include('partials/head', { active: 'overview' }) %>

<h1>Overview</h1>

<div class="grid">
  <div class="stat"><div class="num"><%= sessions.filter(s => s.status === 'connected').length %>/<%= sessions.length %></div><div class="lbl">Online sessions</div></div>
  <div class="stat"><div class="num"><%= counts.contacts %></div><div class="lbl">Contacts</div></div>
  <div class="stat"><div class="num"><%= counts.templates %></div><div class="lbl">Templates</div></div>
  <div class="stat"><div class="num"><%= counts.pending %></div><div class="lbl">Pending scheduled</div></div>
</div>

<div class="card" style="margin-top:16px;">
  <h2 style="margin-top:0;">Recent sends</h2>
  <% if (!recent.length) { %>
    <div class="empty">No messages sent yet - go to <a href="/send">Send</a> to send your first message</div>
  <% } else { %>
    <table>
      <tr><th>Time</th><th>Session</th><th>Recipient</th><th>Message</th></tr>
      <% for (const m of recent) { %>
        <tr>
          <td class="muted"><%= m.created_at %></td>
          <td><%= m.session %></td>
          <td><%= m.chat_id %></td>
          <td><pre class="body"><%= m.body.length > 80 ? m.body.slice(0, 80) + '…' : m.body %></pre></td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>
