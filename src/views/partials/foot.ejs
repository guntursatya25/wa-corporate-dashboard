  </main>
  <script>
    // Insert WhatsApp formatting markers around the current selection or cursor.
    (function initMessageFormatting() {
      const markers = { bold: "*", italic: "_", strike: "~", code: "```" };
      document.querySelectorAll("[data-message-editor]").forEach(function (editor) {
        const textarea = editor.querySelector("textarea");
        if (!textarea) return;
        editor.querySelectorAll("[data-format]").forEach(function (button) {
          button.addEventListener("mousedown", function (event) { event.preventDefault(); });
          button.addEventListener("click", function () {
            const marker = markers[button.dataset.format];
            if (!marker) return;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const selected = textarea.value.slice(start, end);
            const wrapped = marker + selected + marker;
            textarea.value = textarea.value.slice(0, start) + wrapped + textarea.value.slice(end);
            const cursorStart = selected ? start + wrapped.length : start + marker.length;
            textarea.focus();
            textarea.setSelectionRange(selected ? start : cursorStart, selected ? start + wrapped.length : cursorStart);
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
          });
        });
      });
    })();
  </script>

  <script>
    // Render supported WhatsApp markers without allowing user text to become HTML.
    (function initMessagePreview() {
      const slash = String.fromCharCode(92);
      function escapeHtml(value) {
        return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
      }
      function render(value) {
        let html = escapeHtml(value);
        const fence = String.fromCharCode(96).repeat(3);
        html = html.replace(new RegExp(fence + "([^]*?)" + fence, "g"), "<code>$1</code>");
        html = html.replace(new RegExp(slash + "*([^*" + slash + "n]+)" + slash + "*", "g"), "<strong>$1</strong>");
        html = html.replace(new RegExp("_([^_" + slash + "n]+)_", "g"), "<em>$1</em>");
        html = html.replace(new RegExp("~([^~" + slash + "n]+)~", "g"), "<del>$1</del>");
        return html.split(String.fromCharCode(10)).join("<br>");
      }
      document.querySelectorAll("[data-message-editor]").forEach(function (editor) {
        const input = editor.querySelector("textarea");
        const preview = editor.parentElement.querySelector("[data-message-preview]");
        if (!input || !preview) return;
        function update() { preview.innerHTML = input.value ? render(input.value) : "Start typing to preview your WhatsApp message."; }
        input.addEventListener("input", update);
        update();
      });
    })();
  </script>

</body>
</html>
