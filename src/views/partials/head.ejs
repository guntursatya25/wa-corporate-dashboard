<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>WA Corporate Dashboard</title>
  <style>
    :root {
      --bg: #f4f6f9; --card: #fff; --border: #e3e8ee;
      --text: #1f2933; --muted: #6b7683; --primary: #2563eb; --danger: #dc2626;
      --ok-bg: #ecfdf5; --ok-text: #047857; --err-bg: #fef2f2; --err-text: #b91c1c;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif; background: var(--bg); color: var(--text); }
    nav { background: var(--card); border-bottom: 1px solid var(--border); padding: 0 16px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    nav .brand { font-weight: 700; margin-right: 12px; padding: 12px 0; }
    nav a { color: var(--muted); text-decoration: none; padding: 12px 10px; display: inline-block; }
    nav a.active { color: var(--primary); font-weight: 600; box-shadow: inset 0 -2px 0 var(--primary); }
    main { max-width: 960px; margin: 0 auto; padding: 20px 16px 60px; }
    h1 { font-size: 20px; margin: 0 0 16px; }
    h2 { font-size: 16px; margin: 24px 0 8px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
    .stat .num { font-size: 26px; font-weight: 700; }
    .stat .lbl { color: var(--muted); font-size: 13px; margin-top: 2px; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    tr:last-child td { border-bottom: none; }
    input, select, textarea { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; font: inherit; background: #fff; }
    textarea { min-height: 90px; resize: vertical; }
    label { display: block; font-size: 13px; color: var(--muted); margin: 10px 0 4px; }
    button { background: var(--primary); color: #fff; border: none; border-radius: 8px; padding: 8px 16px; font: inherit; cursor: pointer; margin-top: 12px; }
    button.secondary { background: #fff; color: var(--text); border: 1px solid var(--border); }
    button.danger { background: var(--danger); }
    .button-link { display: inline-block; margin: 12px 8px 0 0; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--text); font-size: 14px; }
    button.mini { padding: 4px 10px; margin: 0; font-size: 13px; }
    .flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 14px; }
    .flash.ok { background: var(--ok-bg); color: var(--ok-text); }
    .flash.err { background: var(--err-bg); color: var(--err-text); }
    .muted { color: var(--muted); font-size: 13px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; background: var(--bg); border: 1px solid var(--border); }
    .badge.connected, .badge.sent { background: var(--ok-bg); color: var(--ok-text); border-color: transparent; }
    .badge.qr, .badge.connecting, .badge.reconnecting, .badge.pending { background: #fffbeb; color: #b45309; border-color: transparent; }
    .badge.offline, .badge.logged_out, .badge.failed, .badge.cancelled { background: var(--err-bg); color: var(--err-text); border-color: transparent; }
    .row { display: flex; gap: 12px; flex-wrap: wrap; }
    .row > * { flex: 1; min-width: 180px; }
    .empty { color: var(--muted); padding: 16px 0; text-align: center; }
    pre.body { white-space: pre-wrap; word-break: break-word; margin: 0; font: inherit; }
    :root { --ink:#14202b; --paper:#edf2f4; --surface:#fff; --line:#d6e0e5; --line-strong:#b8c8d0; --text:#1c2a35; --muted:#667784; --cyan:#087f8c; --cyan-dark:#06616b; --cyan-wash:#e1f3f3; --amber:#a65d08; --amber-wash:#fff3d6; --coral:#b5484d; --coral-wash:#fde9e8; --shadow:0 12px 28px rgba(20,32,43,.07); }
    html { background:var(--paper); }
    body { color:var(--text); background:var(--paper); font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif; line-height:1.5; }
    a { color:var(--cyan-dark); } a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible { outline:3px solid rgba(8,127,140,.28); outline-offset:2px; }
    nav { position:sticky; top:0; z-index:5; background:var(--ink); color:#f4f8f9; border-bottom:1px solid #314653; padding:0 24px; gap:5px; } nav .brand { display:inline-flex; align-items:center; gap:10px; min-height:58px; margin-right:20px; color:#fff; font-size:14px; font-weight:760; white-space:nowrap; } nav .brand .icon { width:28px; height:28px; padding:6px; color:var(--ink); background:#9fe1dc; border-radius:7px; }
    nav a { display:inline-flex; align-items:center; gap:8px; min-height:58px; padding:0 11px; color:#b9c9d0; font-size:13px; font-weight:600; border-bottom:2px solid transparent; transition:color .16s ease,background .16s ease,border-color .16s ease; } nav a:hover { color:#fff; background:rgba(255,255,255,.06); } nav a.active { color:#fff; border-bottom-color:#9fe1dc; }
    .icon { width:17px; height:17px; flex:0 0 auto; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    main { width:min(1120px,calc(100% - 32px)); padding:38px 0 72px; } h1 { margin:0; color:var(--ink); font-family:Georgia,Times New Roman,serif; font-size:clamp(28px,4vw,40px); font-weight:500; line-height:1.08; } h1::after { content:""; display:block; width:42px; height:3px; margin-top:13px; background:var(--cyan); }
    h2 { margin:28px 0 10px; color:var(--ink); font-size:16px; font-weight:750; } .card { margin:22px 0; padding:22px; overflow-x:auto; background:var(--surface); border:1px solid var(--line); border-radius:8px; box-shadow:var(--shadow); } .card h2:first-child { margin-top:0; }
    .grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-top:28px; } .stat { min-height:112px; padding:18px; background:var(--surface); border:1px solid var(--line); border-top:3px solid var(--cyan); border-radius:7px; box-shadow:var(--shadow); } .stat:nth-child(2){border-top-color:#d08a27}.stat:nth-child(3){border-top-color:#6d8f9e}.stat:nth-child(4){border-top-color:var(--coral)} .stat .num { color:var(--ink); font-family:Georgia,Times New Roman,serif; font-size:32px; line-height:1; } .stat .lbl { margin-top:10px; color:var(--muted); font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
    table { min-width:650px; font-size:13px; } th,td { padding:13px 12px; border-bottom-color:var(--line); } th { font-size:10px; font-weight:800; letter-spacing:.1em; } tr:hover { background:#f7fafb; }
    input,select,textarea { padding:10px 11px; color:var(--text); background:#fbfcfc; border:1px solid var(--line-strong); border-radius:5px; font-size:14px; } input:focus,select:focus,textarea:focus { background:#fff; border-color:var(--cyan); box-shadow:0 0 0 3px rgba(8,127,140,.1); outline:none; } label { margin:14px 0 6px; color:var(--muted); font-size:11px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; }
    button,.button-link { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:40px; padding:9px 15px; color:#fff; background:var(--cyan); border:1px solid var(--cyan); border-radius:5px; font-size:13px; font-weight:750; text-decoration:none; transition:background .16s ease,border-color .16s ease,transform .16s ease; } button:hover,.button-link:hover { background:var(--cyan-dark); border-color:var(--cyan-dark); } button:active,.button-link:active { transform:translateY(1px); } button.secondary,.button-link.secondary { color:var(--ink); background:#fff; border-color:var(--line-strong); } button.danger { background:var(--coral); border-color:var(--coral); } button.mini { min-height:32px; padding:6px 10px; font-size:12px; }
    .flash { display:flex; align-items:center; gap:10px; margin-bottom:22px; padding:12px 14px; border-radius:6px; font-size:13px; font-weight:650; } .flash::before { content:""; width:8px; height:8px; flex:0 0 auto; border-radius:50%; background:currentColor; } .flash.ok { color:#08735f; background:var(--cyan-wash); border:1px solid #b8e0dd; } .flash.err { color:#a33f43; background:var(--coral-wash); border:1px solid #f0c4c2; }
    .muted { color:var(--muted); font-size:12px; } .badge { min-height:24px; padding:3px 9px; font-size:11px; font-weight:800; } .badge.connected,.badge.sent { color:#08735f; background:var(--cyan-wash); border-color:#b8e0dd; } .badge.qr,.badge.connecting,.badge.reconnecting,.badge.pending { color:var(--amber); background:var(--amber-wash); border-color:#f0d8a4; } .badge.offline,.badge.logged_out,.badge.failed,.badge.cancelled { color:#a33f43; background:var(--coral-wash); border-color:#f0c4c2; } .empty { padding:34px 16px; color:var(--muted); background:#f8fafb; border:1px dashed var(--line-strong); border-radius:6px; }
    .skip-link { position:absolute; left:12px; top:-48px; z-index:10; padding:8px 12px; background:var(--surface); color:var(--ink); border-radius:6px; box-shadow:var(--shadow); } .skip-link:focus { top:12px; }
    @media (max-width:820px) { nav { padding:0 14px; } nav .brand { width:100%; min-height:48px; margin-right:0; } nav a { min-height:44px; padding:0 8px; font-size:12px; } main { width:calc(100% - 24px); padding-top:28px; } .grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media (max-width:520px) { nav { gap:2px; } nav a { flex:1 1 auto; justify-content:center; } nav a .icon { display:none; } .card { padding:16px; } .grid { gap:8px; } .stat { min-height:100px; padding:14px; } .stat .num { font-size:27px; } .stat .lbl { font-size:10px; } }
    @media (prefers-reduced-motion:reduce) { *,*::before,*::after { transition-duration:.01ms !important; animation-duration:.01ms !important; } }
    .template-preview { margin-top:16px; padding:14px 16px; background:#f4f8f9; border:1px solid var(--line); border-radius:6px; } .preview-label { color:var(--muted); font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; } .preview-body { margin-top:8px; min-height:22px; color:var(--text); font-size:14px; } .preview-body code { display:inline-block; padding:2px 5px; background:#e7edef; border-radius:3px; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:12px; } .message-editor { border:1px solid var(--line-strong); border-radius:6px; overflow:hidden; background:#fbfcfc; } .message-editor textarea { display:block; border:0; border-radius:0; background:transparent; } .message-editor textarea:focus { box-shadow:none; } .message-toolbar { display:flex; align-items:center; gap:4px; padding:7px 8px; border-bottom:1px solid var(--line); background:#f4f8f9; } .format-button { display:inline-flex; align-items:center; justify-content:center; width:32px; height:30px; padding:0; margin:0; color:var(--ink); background:transparent; border:1px solid transparent; border-radius:4px; font-size:13px; } .format-button:hover { color:var(--cyan-dark); background:var(--cyan-wash); border-color:#b8e0dd; } .format-button .icon { width:16px; height:16px; } .format-divider { width:1px; height:20px; margin:0 4px; background:var(--line-strong); }
  </style>
</head>
<body>
  <nav>
    <span class="brand"><svg class="icon" aria-hidden="true"><use href="#icon-message"></use></svg><span>WA Corporate</span></span>
    <a href="/" class="<%= typeof active !== 'undefined' && active === 'overview' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-grid"></use></svg>Overview</a>
    <a href="/sessions" class="<%= typeof active !== 'undefined' && active === 'sessions' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-radio"></use></svg>Sessions</a>
    <a href="/send" class="<%= typeof active !== 'undefined' && active === 'send' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-send"></use></svg>Send</a>
    <a href="/scheduled" class="<%= typeof active !== 'undefined' && active === 'scheduled' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-clock"></use></svg>Scheduled</a>
    <a href="/templates" class="<%= typeof active !== 'undefined' && active === 'templates' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-file"></use></svg>Templates</a>
    <a href="/contacts" class="<%= typeof active !== 'undefined' && active === 'contacts' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-users"></use></svg>Contacts</a>
    <a href="/inbox" class="<%= typeof active !== 'undefined' && active === 'inbox' ? 'active' : '' %>"><svg class="icon" aria-hidden="true"><use href="#icon-inbox"></use></svg>Inbox</a>
  </nav>
<svg aria-hidden="true" width="0" height="0" style="position:absolute;overflow:hidden"><symbol id="icon-message" viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.7 8.7 0 0 1-3.8-.9L4 20l1.2-3.7A7.3 7.3 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></symbol><symbol id="icon-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></symbol><symbol id="icon-radio" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/></symbol><symbol id="icon-send" viewBox="0 0 24 24"><path d="m21 3-7.2 18-3.5-7.3L3 10.2 21 3Z"/><path d="M10.3 13.7 21 3"/></symbol><symbol id="icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></symbol><symbol id="icon-file" viewBox="0 0 24 24"><path d="M6 3.5h8l4 4V20.5H6z"/><path d="M14 3.5v4h4M9 12h6M9 16h6"/></symbol><symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="9" r="3"/><path d="M3.5 19c.6-3 2.4-4.5 5.5-4.5s4.9 1.5 5.5 4.5M16 6.5a3 3 0 0 1 0 5.8M16 14.5c2.6.1 4.1 1.5 4.5 4.5"/></symbol><symbol id="icon-inbox" viewBox="0 0 24 24"><path d="M4 5h16l1 10v4H3v-4L4 5Z"/><path d="M3.5 14h4l1.5 2h6l1.5-2h4"/></symbol><symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol><symbol id="icon-save" viewBox="0 0 24 24"><path d="M5 4h12l2 2v14H5z"/><path d="M8 4v6h8V4M8 20v-6h8v6"/></symbol><symbol id="icon-trash" viewBox="0 0 24 24"><path d="M4 7h16M10 11v5M14 11v5M6 7l1 13h10l1-13M9 7V4h6v3"/></symbol><symbol id="icon-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></symbol><symbol id="icon-download" viewBox="0 0 24 24"><path d="M12 4v11M8 11l4 4 4-4M5 20h14"/></symbol><symbol id="icon-x" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol><symbol id="icon-link" viewBox="0 0 24 24"><path d="m10 14 4-4M8 17H6a4 4 0 0 1 0-8h4M16 7h2a4 4 0 0 1 0 8h-4"/></symbol><symbol id="icon-bold" viewBox="0 0 24 24"><path d="M7 4h5a4 4 0 0 1 1 7.9A4 4 0 0 1 12 20H7z"/><path d="M7 12h5"/></symbol><symbol id="icon-italic" viewBox="0 0 24 24"><path d="M10 4h8M6 20h8M14 4 10 20"/></symbol><symbol id="icon-strike" viewBox="0 0 24 24"><path d="M5 12h14M8 7.5C8.7 5.2 11 4 13.5 4c2.2 0 4 1 4.9 2.7M16 16.5c-.8 2.2-2.8 3.5-5.3 3.5-2.4 0-4.3-1-5.4-2.8"/></symbol><symbol id="icon-code" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></symbol></svg>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <main id="main-content">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.kind %>" role="status"><%= flash.msg %></div>
    <% } %>
