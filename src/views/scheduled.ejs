<%- include('partials/head', { active: 'scheduled' }) %>

<h1>Scheduled messages</h1>

<% if (!sessions.length) { %>
  <div class="card"><div class="empty">No online sessions - go to <a href="/sessions">Sessions</a> to connect a WhatsApp account</div></div>
<% } else { %>
  <div class="card">
    <h2 style="margin-top:0;">Create schedule</h2>
    <form method="post" action="/scheduled">
      <div class="row">
        <div>
          <label for="session">Sending session</label>
          <select id="session" name="session" required>
            <% for (const s of sessions) { %>
              <option value="<%= s.name %>"><%= s.name %> <%= s.phone ? '(' + s.phone + ')' : '' %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="template">Use template (optional)</label>
          <select id="template" name="template_select">
            <option value="">— Choose template —</option>
            <% for (const t of templates) { %>
              <option value="<%= t.id %>" data-body="<%= t.body.replace(/"/g, '&quot;') %>"><%= t.name %></option>
            <% } %>
          </select>
        </div>
      </div>

      <label for="chat_id">Recipient (phone / chat ID)</label>
      <div class="row">
        <input id="chat_id" name="chat_id" placeholder="6281234567890" required>
        <div>
          <label for="contact_pick" style="margin-top:0;">Choose from contacts</label>
          <select id="contact_pick">
            <option value="">— Contacts —</option>
            <% for (const c of contacts) { %>
              <option value="<%= c.phone %>"><%= c.name %> (<%= c.phone %>)</option>
            <% } %>
          </select>
        </div>
      </div>

      <label for="body">Message</label>
      <textarea id="body" name="body" required></textarea>

      <div class="row">
        <div>
          <label for="run_at">One-time - specify time</label>
          <input id="run_at" type="datetime-local" name="run_at">
        </div>
        <div>
          <label for="cron">Or recurring - cron expression (5 fields)</label>
          <input id="cron" name="cron" placeholder="e.g. 0 9 * * 1-5 (weekdays at 9:00)">
        </div>
      </div>
      <p class="muted">Choose one: cron takes precedence over the specified time. Input and display use <strong><%= timezone %></strong>; the database stores UTC.</p>

      <button type="submit">Create schedule</button>
    </form>
  </div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;">Pending (<%= pending.length %>)</h2>
  <% if (!pending.length) { %>
    <div class="empty">No pending schedules</div>
  <% } else { %>
    <table>
      <tr><th>Run time (UTC)</th><th>Sessions</th><th>Recipient</th><th>Message</th><th>Recurring</th><th></th></tr>
      <% for (const s of pending) { %>
        <tr>
          <td><%= formatLocalDateTime(s.run_at) %></td>
          <td><%= s.session %></td>
          <td><%= s.chat_id %></td>
          <td><pre class="body"><%= s.body.length > 60 ? s.body.slice(0, 60) + '…' : s.body %></pre></td>
          <td><span class="badge <%= s.recurring ? 'pending' : '' %>"><%= s.recurring ? s.cron : 'One-time' %></span></td>
          <td>
            <form method="post" action="/scheduled/cancel" style="margin:0;">
              <input type="hidden" name="id" value="<%= s.id %>">
              <button class="mini secondary" type="submit">Cancel</button>
            </form>
          </td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">History</h2>
  <% if (!history.length) { %>
    <div class="empty">No history yet</div>
  <% } else { %>
    <table>
      <tr><th>Status</th><th>Run time (UTC)</th><th>Sessions</th><th>Recipient</th><th>Message</th><th>Error</th></tr>
      <% for (const s of history) { %>
        <tr>
          <td><span class="badge <%= s.status %>"><%= s.status %></span></td>
          <td class="muted"><%= s.last_run_at ? formatLocalDateTime(s.last_run_at) : '—' %></td>
          <td><%= s.session %></td>
          <td><%= s.chat_id %></td>
          <td><pre class="body"><%= s.body.length > 50 ? s.body.slice(0, 50) + '…' : s.body %></pre></td>
          <td class="muted"><%= s.last_error || '' %></td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<script>
  document.getElementById('template')?.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    if (opt && opt.dataset.body) document.getElementById('body').value = opt.dataset.body;
  });
  document.getElementById('contact_pick')?.addEventListener('change', function () {
    if (this.value) document.getElementById('chat_id').value = this.value;
  });
</script>

<%- include('partials/foot') %>
