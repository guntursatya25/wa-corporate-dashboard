<%- include('partials/head', { active: 'send' }) %>

<h1>Send message</h1>

<% if (!sessions.length) { %>
  <div class="card"><div class="empty">No online sessions - go to <a href="/sessions">Sessions</a> to connect a WhatsApp account</div></div>
<% } else { %>
  <div class="card">
    <form method="post" action="/send">
      <div class="row">
        <div>
          <label for="session">Sending session</label>
          <select id="session" name="session" required>
            <% for (const s of sessions) { %>
              <option value="<%= s.name %>"><%= s.name %> <%= s.phone ? '(' + s.phone + ')' : '' %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="template">Use template (optional)</label>
          <select id="template" name="template_select">
            <option value="">— Choose template —</option>
            <% for (const t of templates) { %>
              <option value="<%= t.id %>" data-body="<%= t.body.replace(/"/g, '&quot;') %>"><%= t.name %></option>
            <% } %>
          </select>
        </div>
      </div>

      <label for="send-mode">Recipients</label>
      <select id="send-mode" name="send_mode">
        <option value="individual">One contact or chat ID</option>
        <option value="group">Contact group</option>
      </select>

      <div id="individual-target">
        <label for="chat_id">Recipient (phone / chat ID)</label>
        <div class="row">
          <input id="chat_id" name="chat_id" placeholder="6281234567890 or 62812…@g.us" required>
          <div>
            <label for="contact_pick" style="margin-top:0;">Choose from contacts</label>
            <select id="contact_pick">
              <option value="">— Contacts —</option>
              <% for (const c of contacts) { %>
                <option value="<%= c.phone %>" data-name="<%= c.name %>"><%= c.name %> (<%= c.phone %>)</option>
              <% } %>
            </select>
          </div>
        </div>
      </div>

      <div id="group-target" hidden>
        <label for="group_id">Contact group</label>
        <select id="group_id" name="group_id">
          <option value="">— Choose group —</option>
          <% for (const group of groups) { %>
            <option value="<%= group.id %>"><%= group.name %> (<%= group.member_count %> contacts)</option>
          <% } %>
        </select>
        <% if (!groups.length) { %>
          <p class="muted">No groups yet. Create one from <a href="/contacts">Contacts</a>.</p>
        <% } else { %>
          <p class="muted">The message will be sent one contact at a time. Failed recipients will not stop the remaining sends.</p>
        <% } %>
      </div>

      <label for="body">Message</label>
      <div class="message-editor" data-message-editor>
        <div class="message-toolbar" role="toolbar" aria-label="Message formatting">
          <button type="button" class="format-button" data-format="bold" title="Bold" aria-label="Bold"><svg class="icon" aria-hidden="true"><use href="#icon-bold"></use></svg></button>
          <button type="button" class="format-button" data-format="italic" title="Italic" aria-label="Italic"><svg class="icon" aria-hidden="true"><use href="#icon-italic"></use></svg></button>
          <button type="button" class="format-button" data-format="strike" title="Strikethrough" aria-label="Strikethrough"><svg class="icon" aria-hidden="true"><use href="#icon-strike"></use></svg></button>
          <span class="format-divider" aria-hidden="true"></span>
          <button type="button" class="format-button" data-format="code" title="Monospace" aria-label="Monospace"><svg class="icon" aria-hidden="true"><use href="#icon-code"></use></svg></button>
        </div>
        <textarea id="body" name="body" required placeholder="Enter a message…"></textarea>
      </div>
      <div class="template-preview" aria-live="polite">
        <div class="preview-label">Live preview</div>
        <div class="preview-body" data-message-preview>Start typing to preview your WhatsApp message.</div>
      </div>

      <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-send"></use></svg>Send message</button>
    </form>
  </div>
<% } %>

<script>
  const sendMode = document.getElementById('send-mode');
  const individualTarget = document.getElementById('individual-target');
  const groupTarget = document.getElementById('group-target');
  const chatInput = document.getElementById('chat_id');
  const groupInput = document.getElementById('group_id');
  function updateRecipientMode() {
    const isGroup = sendMode?.value === 'group';
    if (individualTarget) individualTarget.hidden = isGroup;
    if (groupTarget) groupTarget.hidden = !isGroup;
    if (chatInput) chatInput.required = !isGroup;
    if (groupInput) groupInput.required = isGroup;
  }
  sendMode?.addEventListener('change', updateRecipientMode);
  updateRecipientMode();

  document.getElementById('template')?.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    if (opt && opt.dataset.body) document.getElementById('body').value = opt.dataset.body;
    document.getElementById('body')?.dispatchEvent(new Event('input', { bubbles: true }));
  });
  document.getElementById('contact_pick')?.addEventListener('change', function () {
    if (this.value) document.getElementById('chat_id').value = this.value;
  });
</script>

<%- include('partials/foot') %>
