<%- include('partials/head', { active: 'send' }) %>

<h1>发送消息</h1>

<% if (!sessions.length) { %>
  <div class="card"><div class="empty">没有在线会话 — 先到 <a href="/sessions">会话</a> 连接一个 WhatsApp 账号</div></div>
<% } else { %>
  <div class="card">
    <form method="post" action="/send">
      <div class="row">
        <div>
          <label for="session">发送会话</label>
          <select id="session" name="session" required>
            <% for (const s of sessions) { %>
              <option value="<%= s.name %>"><%= s.name %> <%= s.phone ? '(' + s.phone + ')' : '' %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="template">套用模板（可选）</label>
          <select id="template" name="template_select">
            <option value="">— 选择模板 —</option>
            <% for (const t of templates) { %>
              <option value="<%= t.id %>" data-body="<%= t.body.replace(/"/g, '&quot;') %>"><%= t.name %></option>
            <% } %>
          </select>
        </div>
      </div>

      <label for="chat_id">收件人（号码 / chat id）</label>
      <div class="row">
        <input id="chat_id" name="chat_id" placeholder="6281234567890 或 62812…@g.us" required>
        <div>
          <label for="contact_pick" style="margin-top:0;">从联系人选择</label>
          <select id="contact_pick">
            <option value="">— 联系人 —</option>
            <% for (const c of contacts) { %>
              <option value="<%= c.phone %>" data-name="<%= c.name %>"><%= c.name %> (<%= c.phone %>)</option>
            <% } %>
          </select>
        </div>
      </div>

      <label for="body">消息内容</label>
      <textarea id="body" name="body" required placeholder="输入消息…"></textarea>

      <button type="submit">发送</button>
    </form>
  </div>
<% } %>

<script>
  // Template autofill: put template body into the textarea.
  document.getElementById('template')?.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    if (opt && opt.dataset.body) document.getElementById('body').value = opt.dataset.body;
  });
  // Contact picker: fill chat_id with the selected contact's phone.
  document.getElementById('contact_pick')?.addEventListener('change', function () {
    if (this.value) document.getElementById('chat_id').value = this.value;
  });
</script>

<%- include('partials/foot') %>
