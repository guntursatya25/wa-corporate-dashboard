<%- include('partials/head', { active: 'sessions' }) %>

<h1>Session management</h1>

<div class="card">
  <h2 style="margin-top:0;">Add session</h2>
  <form method="post" action="/sessions/start" class="row">
    <div>
      <label for="name">Session name (letters, numbers, and - only)</label>
      <input id="name" name="name" placeholder="e.g. sales-1" required pattern="[\w-]+">
    </div>
    <div style="flex:0;">
      <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-plus"></use></svg>Create / connect</button>
    </div>
  </form>
  <p class="muted" style="margin-bottom:0;">A QR code will appear after creation. Scan it with WhatsApp: Linked devices > Link a device.</p>
</div>

<div class="card">
  <% if (!sessions.length) { %>
    <div class="empty">No sessions yet - use the form above to create the first one</div>
  <% } else { %>
    <table>
      <tr><th>Name</th><th>Status</th><th>Phone</th><th>Auth saved</th><th style="width:140px;"></th></tr>
      <% for (const s of sessions) { const st = states[s.name] || {}; %>
        <tr data-session="<%= s.name %>">
          <td><strong><%= s.name %></strong></td>
          <td><span class="badge <%= s.status %>" data-role="status"><%= s.status %></span></td>
          <td data-role="phone"><%= s.phone || st.phone || '—' %></td>
          <td><%= s.hasAuth ? '✓' : '—' %></td>
          <td>
            <form method="post" action="/sessions/stop" style="margin:0;" onsubmit="return confirm('Disconnect and delete session <%= s.name %> ?')">
              <input type="hidden" name="name" value="<%= s.name %>">
              <button class="mini danger" type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-link"></use></svg>Disconnect</button>
            </form>
          </td>
        </tr>
        <% if (s.status === 'qr' || st.status === 'qr') { %>
          <tr>
            <td colspan="5" style="text-align:center;">
              <img data-role="qr" alt="QR" style="width:220px;height:220px;"
                   src="<%= st.qr || '' %>">
              <p class="muted" data-role="qr-hint">The QR code refreshes automatically - open WhatsApp > Linked devices > Link a device</p>
            </td>
          </tr>
        <% } %>
      <% } %>
    </table>
  <% } %>
</div>

<script>
  // Poll QR status for sessions that are not yet connected; refresh badge + QR image.
  (function poll() {
    const rows = document.querySelectorAll('tr[data-session]');
    if (!rows.length) return;
    rows.forEach(function (row) {
      const name = row.dataset.session;
      fetch('/api/qr/' + encodeURIComponent(name))
        .then(function (r) { return r.json(); })
        .then(function (s) {
          const badge = row.querySelector('[data-role="status"]');
          if (badge && s.status) { badge.textContent = s.status; badge.className = 'badge ' + s.status; }
          const phone = row.querySelector('[data-role="phone"]');
          if (phone && s.phone) phone.textContent = s.phone;
          const qrImg = row.parentElement.querySelector('img[data-role="qr"]');
          if (qrImg && s.qr) qrImg.src = s.qr;
        })
        .catch(function () {});
    });
    setTimeout(poll, 2000);
  })();
</script>

<%- include('partials/foot') %>
