<%- include('partials/head', { active: 'templates' }) %>

<h1>Message templates</h1>

<div class="card">
  <h2 style="margin-top:0;">Add / update template</h2>
  <form method="post" action="/templates">
    <label for="name">Template name (same name overwrites)</label>
    <input id="name" name="name" placeholder="e.g. payment-reminder" required>
    <label for="body">Message</label>
    <div class="message-editor" data-message-editor>
        <div class="message-toolbar" role="toolbar" aria-label="Message formatting">
          <button type="button" class="format-button" data-format="bold" title="Bold" aria-label="Bold"><svg class="icon" aria-hidden="true"><use href="#icon-bold"></use></svg></button>
          <button type="button" class="format-button" data-format="italic" title="Italic" aria-label="Italic"><svg class="icon" aria-hidden="true"><use href="#icon-italic"></use></svg></button>
          <button type="button" class="format-button" data-format="strike" title="Strikethrough" aria-label="Strikethrough"><svg class="icon" aria-hidden="true"><use href="#icon-strike"></use></svg></button>
          <span class="format-divider" aria-hidden="true"></span>
          <button type="button" class="format-button" data-format="code" title="Monospace" aria-label="Monospace"><svg class="icon" aria-hidden="true"><use href="#icon-code"></use></svg></button>
        </div>
        <textarea id="body" name="body" required placeholder="Template text…"></textarea>
      </div>
    <button type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-save"></use></svg>Save template</button>
  </form>
</div>

<div class="card">
  <% if (!templates.length) { %>
    <div class="empty">No templates yet</div>
  <% } else { %>
    <table>
      <tr><th>Name</th><th>Message</th><th>Created</th><th style="width:80px;"></th></tr>
      <% for (const t of templates) { %>
        <tr>
          <td><strong><%= t.name %></strong></td>
          <td><pre class="body"><%= t.body %></pre></td>
          <td class="muted"><%= t.created_at %></td>
          <td>
            <form method="post" action="/templates/delete" style="margin:0;" onsubmit="return confirm('Delete template <%= t.name %> ?')">
              <input type="hidden" name="id" value="<%= t.id %>">
              <button class="mini danger" type="submit"><svg class="icon button-icon" aria-hidden="true"><use href="#icon-trash"></use></svg>Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>
